# Copy to `.env` and adjust. All entries are optional.

# Dataset root containing train/ and test/ folders with hdf5 files
US3D_DATA_DIR=/path/to/data
# Where inference / training outputs are written (default: ./results)
# US3D_RESULTS_DIR=/path/to/results

# Models: local preset folder or hf://<repo_id>
# Diffusion model (default: results/models/diffusion, where train.py saves it)
# US3D_DIFFUSION_MODEL=/path/to/model
# Optional supervised U-Net baseline (inference.py --methods ... supervised)
# US3D_SUPERVISED_MODEL=/path/to/unet

# Hugging Face token, only needed for private models / datasets on the Hub
# HF_TOKEN=

KERAS_BACKEND=jax
